+/*
+ * moose-ripple: arrays of temporaries indexed by selects.
+ *
+ * A small indexable temp array (x#[] in Direct3D 10 shaders) is declared as plain registers,
+ * and an access through an index held in a register becomes compare-and-select over its
+ * elements: a read gathers the element into a temporary before the instruction, a write goes
+ * to a temporary that is scattered to the elements after it (translate_flush_scatters). The
+ * host then gets no dynamically indexed temporaries, which its GPU compiler may keep in
+ * scratch memory: Intel's took about 20 ms a frame on one such geometry shader.
+ * RIPPLE_INDEXED_TEMPS (any value) keeps the arrays as before.
+ */
+#define SHADER_SELECT_MAX_ELEMENTS 16
+
+static bool
+select_indexable_temps(void)
+{
+   static int on = -1;
+   if (on < 0)
+      on = getenv("RIPPLE_INDEXED_TEMPS") == NULL;
+   return on;
+}
+
+/* A temporary for one instruction, free again after it */
+static struct ureg_dst
+insn_temp(struct Shader_xlate *sx)
+{
+   struct ureg_dst t = ureg_DECL_temporary(sx->ureg);
+   if (sx->num_insn_temps < ARRAY_SIZE(sx->insn_temps))
+      sx->insn_temps[sx->num_insn_temps++] = t;
+   return t;
+}
+
+/* The element an access names, computed before the instruction, in .x of a temporary */
+static struct ureg_src
+select_element_index(struct Shader_xlate *sx, const struct Shader_index *index)
+{
+   struct ureg_dst i = ureg_writemask(insn_temp(sx), TGSI_WRITEMASK_X);
+   struct ureg_src rel = relative_value(sx, &index->rel);
+   if (index->index_rep == D3D10_SB_OPERAND_INDEX_IMMEDIATE32_PLUS_RELATIVE && index->imm)
+      ureg_UADD(sx->ureg, i, rel, ureg_imm1u(sx->ureg, index->imm));
+   else
+      ureg_MOV(sx->ureg, i, rel);
+   return ureg_scalar(ureg_src(i), TGSI_SWIZZLE_X);
+}
+
+static struct ureg_src
+translate_indexable_temp_select(struct Shader_xlate *sx,
+                                const struct Shader_operand *operand,
+                                bool dst, uint writemask)
+{
+   const uint offset = sx->indexable_temp_offsets[operand->index[0].imm];
+   const uint count = sx->indexable_temp_counts[operand->index[0].imm];
+   struct ureg_src index = select_element_index(sx, &operand->index[1]);
+   struct ureg_dst value = insn_temp(sx);
+
+   if (dst) {
+      if (sx->num_scatters < ARRAY_SIZE(sx->scatters)) {
+         sx->scatters[sx->num_scatters].value = value;
+         sx->scatters[sx->num_scatters].index = index;
+         sx->scatters[sx->num_scatters].offset = offset;
+         sx->scatters[sx->num_scatters].count = count;
+         sx->scatters[sx->num_scatters].writemask = writemask;
+         sx->num_scatters++;
+      } else {
+         LOG_UNSUPPORTED(true);
+      }
+      return ureg_src(value);
+   }
+
+   struct ureg_dst cond = ureg_writemask(insn_temp(sx), TGSI_WRITEMASK_X);
+   ureg_MOV(sx->ureg, value, ureg_src(sx->temps[offset]));
+   for (uint e = 1; e < count; e++) {
+      ureg_USEQ(sx->ureg, cond, index, ureg_imm1u(sx->ureg, e));
+      ureg_UCMP(sx->ureg, value, ureg_scalar(ureg_src(cond), TGSI_SWIZZLE_X),
+                ureg_src(sx->temps[offset + e]), ureg_src(value));
+   }
+   return ureg_src(value);
+}
+
+/* After an instruction: its writes through an index reach the elements, and its temporaries
+ * are free again */
+static void
+translate_flush_scatters(struct Shader_xlate *sx)
+{
+   for (uint s = 0; s < sx->num_scatters; s++) {
+      struct ureg_dst cond = ureg_writemask(ureg_DECL_temporary(sx->ureg), TGSI_WRITEMASK_X);
+      for (uint e = 0; e < sx->scatters[s].count; e++) {
+         struct ureg_dst element = sx->temps[sx->scatters[s].offset + e];
+         ureg_USEQ(sx->ureg, cond, sx->scatters[s].index, ureg_imm1u(sx->ureg, e));
+         ureg_UCMP(sx->ureg, ureg_writemask(element, sx->scatters[s].writemask),
+                   ureg_scalar(ureg_src(cond), TGSI_SWIZZLE_X),
+                   ureg_src(sx->scatters[s].value), ureg_src(element));
+      }
+      ureg_release_temporary(sx->ureg, cond);
+   }
+   sx->num_scatters = 0;
+   for (uint t = 0; t < sx->num_insn_temps; t++)
+      ureg_release_temporary(sx->ureg, sx->insn_temps[t]);
+   sx->num_insn_temps = 0;
+}
