+static void
+virgl_gdi_winsys_flush_frontbuffer(struct virgl_winsys *qws,
+                                   struct virgl_cmd_buf *_cmdbuf,
+                                   struct virgl_hw_res *res, unsigned level,
+                                   unsigned layer, void *winsys_drawable_handle,
+                                   struct pipe_box *sub_box)
+{
