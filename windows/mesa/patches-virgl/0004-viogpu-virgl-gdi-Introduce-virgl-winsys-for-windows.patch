+static void
+virgl_gdi_resource_cache_entry_release(struct virgl_resource_cache_entry *entry,
+                                       void *user_data)
+{
+   struct virgl_gdi_winsys *qdws = user_data;
+   struct virgl_hw_res *res = cache_entry_container_res(entry);
