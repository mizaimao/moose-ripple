From 62f1e49a1eb3a408f748725326fe53447887f97d Mon Sep 17 00:00:00 2001
From: Max R <max8rr8@gmail.com>
Date: Fri, 21 Jul 2023 21:19:34 +0300
Subject: [PATCH 5/5] targets: Add virgl to wgl and d3d10 targets

On the WGL target virgl is added like other drivers.
dxgi_framebuffer.cpp is introduced to implement wgl display
over DXGI swapchain to avoid cpu copy.

On the d3d10 target:
* Rename to d3d10umd from d3d10sw (as it's not only sw anymore)
* If DRIVER_VIRGL is defined we use virgl to create display
* Follow naming defined in gallium-d3d10-dll-name
---
 meson.build                                  |  12 +-
 src/gallium/targets/d3d10umd/d3d10_gdi.c     |  13 +-
 src/gallium/targets/d3d10umd/meson.build     |   6 +-
 src/gallium/targets/wgl/dxgi_framebuffer.cpp | 292 +++++++++++++++++++
 src/gallium/targets/wgl/meson.build          |   4 +-
 src/gallium/targets/wgl/wgl.c                |  33 +++
 6 files changed, 351 insertions(+), 9 deletions(-)
 create mode 100644 src/gallium/targets/wgl/dxgi_framebuffer.cpp

diff --git a/meson.build b/meson.build
index 99a771c737d..1b1f5b8aba0 100644
--- a/meson.build
+++ b/meson.build
@@ -782,12 +782,20 @@ if with_gallium_st_nine
     error('Using nine with wine requires dri3')
   endif
 endif
+
 with_gallium_st_d3d10umd =  get_option('gallium-d3d10umd')
 if with_gallium_st_d3d10umd
-  if not with_gallium_swrast
-    error('The d3d10umd state tracker requires gallium softpipe/llvmpipe.')
+  if not [
+           with_gallium_swrast,
+           with_gallium_virgl,
+         ].contains(true)
+    error('The d3d10umd state tracker requires gallium softpipe/llvmpipe or virgl.')
+  endif
+  if with_gallium_softpipe and with_gallium_virgl
+    warning('The d3d10umd state trackes is built with both softpipe/llvmpipe and virgl, only virgl will be used.')
   endif
 endif
+
 _power8 = get_option('power8')
 if _power8.allowed()
   if host_machine.cpu_family() == 'ppc64' and host_machine.endian() == 'little'
