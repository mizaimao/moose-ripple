d3d10umd: no Direct3D 10 device on a host renderer below GLSL 1.50

A host renderer with GLSL 1.30 only (UTM on Apple silicon: virglrenderer over ANGLE) cannot
draw what Direct3D 10 programs and the compositor send, yet virgl reports geometry shaders
there. The device is refused, so the compositor does without and the desktop is drawn plainly
instead of a broken picture. Also no screen is used without checking that one was made.

---
--- a/src/gallium/frontends/d3d10umd/Device.cpp
+++ b/src/gallium/frontends/d3d10umd/Device.cpp
@@ -1,3 +1,4 @@
+#include "RippleLog.h"
 /**************************************************************************
  *
  * Copyright 2012-2021 VMware, Inc.
@@ -149,8 +150,28 @@
    mtx_init(&pDevice->CreateResourceMtx, mtx_plain);
 
    struct pipe_screen *screen = d3d10_create_screen(&pDevice->device.base);
-   if (screen)
-      FormatInitForScreen(screen);
+   if (!screen) {
+      mtx_destroy(&pDevice->CreateResourceMtx);
+      return E_FAIL;
+   }
+   /* moose-ripple: Direct3D 10 needs a host renderer of GLSL 1.50 or more (geometry shaders,
+    * and what comes with them). One that offers less, as UTM's on Apple silicon with GLSL 1.30
+    * (which still reports geometry shaders through virgl), cannot draw what Direct3D 10
+    * programs and the compositor send: the device is refused, so the compositor does without
+    * and the desktop is drawn plainly, instead of a broken picture.
+    */
+   ripple_logf("d3d10: host renderer GLSL level %d, geometry shader instructions %d",
+               screen->get_param(screen, PIPE_CAP_GLSL_FEATURE_LEVEL),
+               screen->get_shader_param(screen, PIPE_SHADER_GEOMETRY, PIPE_SHADER_CAP_MAX_INSTRUCTIONS));
+   if (screen->get_shader_param(screen, PIPE_SHADER_GEOMETRY, PIPE_SHADER_CAP_MAX_INSTRUCTIONS) == 0 ||
+       screen->get_param(screen, PIPE_CAP_GLSL_FEATURE_LEVEL) < 150) {
+      ripple_logf("d3d10: no device: the host renderer offers GLSL level %d, Direct3D 10 needs 150",
+                  screen->get_param(screen, PIPE_CAP_GLSL_FEATURE_LEVEL));
+      screen->destroy(screen);
+      mtx_destroy(&pDevice->CreateResourceMtx);
+      return E_FAIL;
+   }
+   FormatInitForScreen(screen);
    struct pipe_context *pipe = screen->context_create(screen, NULL, 0);
    pDevice->screen = screen;
    pDevice->pipe = pipe;
