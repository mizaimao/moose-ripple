+/*
+ * moose-ripple: run-time indexes one at a time, through ADDR[0].
+ *
+ * virglrenderer writes every indexed store to a temporary array through addr0, and 0.10.4 also
+ * reads indexed constants through addr0, whatever address register the shader names; it drops
+ * the constant part of a run-time geometry shader vertex index, and it cannot index immediates
+ * at all. So each indexed read is a MOV of its own right after the UARL that sets ADDR[0], into
+ * a temporary the instruction then reads; each indexed write goes to a temporary, stored
+ * through ADDR[0] after the instruction (translate_flush_scatters). Mesa's own TGSI producer
+ * keeps to the same habit.
+ */
+#define SHADER_ICB_COPY_MAX 64
+
+/* The index of an access, in .x of a temporary, computed before the instruction (which may
+ * change the register it comes from); fold: with the immediate part added */
+static struct ureg_src
+indirect_index(struct Shader_xlate *sx, const struct Shader_index *index, bool fold)
+{
+   struct ureg_dst i = ureg_writemask(insn_temp(sx), TGSI_WRITEMASK_X);
+   struct ureg_src rel = relative_value(sx, &index->rel);
+   if (fold && index->index_rep == D3D10_SB_OPERAND_INDEX_IMMEDIATE32_PLUS_RELATIVE && index->imm)
+      ureg_UADD(sx->ureg, i, rel, ureg_imm1u(sx->ureg, index->imm));
+   else
+      ureg_MOV(sx->ureg, i, rel);
+   return ureg_scalar(ureg_src(i), TGSI_SWIZZLE_X);
+}
+
+static struct ureg_src
+fetch_indirect(struct Shader_xlate *sx, struct ureg_src base, struct ureg_src index)
+{
+   struct ureg_dst value = insn_temp(sx);
+   ureg_UARL(sx->ureg, sx->addrs[0], index);
+   ureg_MOV(sx->ureg, value, ureg_src_indirect(base, ureg_src(sx->addrs[0])));
+   return ureg_src(value);
+}
+
+static struct ureg_dst
+store_indirect(struct Shader_xlate *sx, struct ureg_dst base, struct ureg_src index,
+               uint writemask, bool color)
+{
+   struct ureg_dst value = insn_temp(sx);
+   if (sx->num_stores < ARRAY_SIZE(sx->stores)) {
+      sx->stores[sx->num_stores].base = base;
+      sx->stores[sx->num_stores].value = value;
+      sx->stores[sx->num_stores].index = index;
+      sx->stores[sx->num_stores].writemask = writemask;
+      sx->stores[sx->num_stores].color = color;
+      sx->num_stores++;
+   } else {
+      LOG_UNSUPPORTED(true);
+   }
+   return value;
+}
+
+/* A read of the immediate constant buffer at a run-time index: selects over a small one, the
+ * copy (made at its declaration) for a bigger one */
+static struct ureg_src
+translate_icb_indirect(struct Shader_xlate *sx, const struct Shader_index *index)
+{
+   struct ureg_src i = indirect_index(sx, index, true);
+
+   if (sx->icb_copied) {
+      /* the copy has a zero element after the table: an index past it reads zero */
+      struct ureg_dst clamped = ureg_writemask(insn_temp(sx), TGSI_WRITEMASK_X);
+      ureg_UMIN(sx->ureg, clamped, i, ureg_imm1u(sx->ureg, sx->icb_count));
+      return fetch_indirect(sx, ureg_src(sx->icb_array), ureg_scalar(ureg_src(clamped), TGSI_SWIZZLE_X));
+   }
+
+   if (sx->icb_count && sx->icb_count <= SHADER_SELECT_MAX_ELEMENTS) {
+      struct ureg_dst value = insn_temp(sx);
+      struct ureg_dst cond = ureg_writemask(insn_temp(sx), TGSI_WRITEMASK_X);
+      /* zero when the index matches no element, as Direct3D reads past a constant buffer */
+      ureg_MOV(sx->ureg, value, ureg_imm1u(sx->ureg, 0));
+      for (uint e = 0; e < sx->icb_count; e++) {
+         struct ureg_src element = sx->imms;
+         element.Index += e;
+         ureg_USEQ(sx->ureg, cond, i, ureg_imm1u(sx->ureg, e));
+         ureg_UCMP(sx->ureg, value, ureg_scalar(ureg_src(cond), TGSI_SWIZZLE_X), element,
+                   ureg_src(value));
+      }
+      return ureg_src(value);
+   }
+
+   if (!sx->icb_warned) {
+      sx->icb_warned = true;
+      ripple_logf("d3d10: an immediate constant buffer of %u entries is indexed at run time; "
+                  "past %u entries such reads give entry 0", sx->icb_count, SHADER_ICB_COPY_MAX);
+   }
+   LOG_UNSUPPORTED(true);
+   return sx->imms;
+}
