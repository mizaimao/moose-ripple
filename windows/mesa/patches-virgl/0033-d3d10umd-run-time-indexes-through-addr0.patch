+/* An input with two indexes (a geometry shader's vertex and register), either at run time */
+static struct ureg_src
+translate_input_2d(struct Shader_xlate *sx, const struct Shader_operand *operand)
+{
+   const struct Shader_index *vertex = &operand->index[0];
+   const struct Shader_index *reg_index = &operand->index[1];
+   const bool rel_vertex = vertex->index_rep != D3D10_SB_OPERAND_INDEX_IMMEDIATE32;
+   const bool rel_reg = reg_index->index_rep != D3D10_SB_OPERAND_INDEX_IMMEDIATE32;
+   struct ureg_src reg = sx->inputs[rel_reg && reg_index->index_rep ==
+                                    D3D10_SB_OPERAND_INDEX_RELATIVE ? 0 : reg_index->imm].reg;
+
+   if (!rel_vertex && !rel_reg)
+      return ureg_src_dimension(reg, vertex->imm);
+
+   /* the host drops the constant part of a run-time vertex index: it goes into the index */
+   struct ureg_src vi = rel_vertex ? indirect_index(sx, vertex, true) : ureg_src_undef();
+   struct ureg_src ri = rel_reg ? indirect_index(sx, reg_index, false) : ureg_src_undef();
+   struct ureg_dst value = insn_temp(sx);
+
+   if (rel_vertex)
+      ureg_UARL(sx->ureg, sx->addrs[1], vi);
+   if (rel_reg) {
+      ureg_UARL(sx->ureg, sx->addrs[0], ri);
+      reg = ureg_src_indirect(reg, ureg_src(sx->addrs[0]));
+   }
+   reg = rel_vertex ? ureg_src_dimension_indirect(reg, ureg_src(sx->addrs[1]), 0)
+                    : ureg_src_dimension(reg, vertex->imm);
+   ureg_MOV(sx->ureg, value, reg);
+   return ureg_src(value);
+}
