+                     util_format_name(templat.format), (unsigned)pCreateResource->Format,
+                     (unsigned)templat.target, templat.width0, templat.height0, templat.depth0,
+                     templat.last_level + 1, templat.nr_samples, templat.bind);
          SetError(hDevice, E_OUTOFMEMORY);
