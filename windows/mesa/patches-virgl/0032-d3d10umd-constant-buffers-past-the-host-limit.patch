+/* moose-ripple: constant buffer slots at or past the screen's constant buffer limit (virgl's
+ * host counts the ordinary uniforms and its own helper block in it) are read as buffer textures.
+ * The caller gives the limit and the sampler view to start at; the translator says which slots
+ * and through which views. */
+#define SHADER_MAX_CB_VIEWS 4
+struct Shader_cb_views {
+   unsigned max_const_buffers;   /* in: PIPE_SHADER_CAP_MAX_CONST_BUFFERS, 0 = no limit */
+   unsigned view_base;           /* in: the first such slot's sampler view; the next count down */
+   unsigned count;               /* out */
+   unsigned slot[SHADER_MAX_CB_VIEWS];
+   unsigned view[SHADER_MAX_CB_VIEWS];
+};
