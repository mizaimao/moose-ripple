+/*
+ * moose-ripple: constant buffers past the host's limit (Shader_cb_views).
+ */
+static void
+ShaderInitCbViews(Device *pDevice, enum pipe_shader_type type, struct Shader_cb_views *views)
+{
+   struct pipe_screen *screen = pDevice->screen;
+   memset(views, 0, sizeof *views);
+   int max_cb = screen->get_shader_param(screen, type, PIPE_SHADER_CAP_MAX_CONST_BUFFERS);
+   /* RIPPLE_CB_LIMIT: a lower limit than the host's, to try the buffer texture path anywhere */
+   const char *limit = getenv("RIPPLE_CB_LIMIT");
+   if (limit && atoi(limit) > 0)
+      max_cb = MIN2(max_cb, atoi(limit));
+   int max_views = screen->get_shader_param(screen, type, PIPE_SHADER_CAP_MAX_SAMPLER_VIEWS);
+   if (max_views <= 0)
+      max_views = screen->get_shader_param(screen, type, PIPE_SHADER_CAP_MAX_TEXTURE_SAMPLERS);
+   max_views = MIN2(max_views, PIPE_MAX_SHADER_SAMPLER_VIEWS);
+   /* Direct3D 10 slot n is constant buffer n + 1 */
+   if (max_cb > 0 && max_cb <= D3D10_COMMONSHADER_CONSTANT_BUFFER_API_SLOT_COUNT &&
+       max_views > SHADER_MAX_CB_VIEWS) {
+      views->max_const_buffers = max_cb;
+      /* below 16: a host may give a vertex shader fewer texture units than a pixel shader */
+      views->view_base = MIN2(max_views, 16) - 1;
+   }
+}
+
+/* Before a draw: each bound shader's buffer views look at the buffers bound to its slots */
+void
+UpdateCbViews(Device *pDevice)
+{
+   struct pipe_context *pipe = pDevice->pipe;
+
+   for (unsigned type = 0; type < PIPE_SHADER_TYPES; type++) {
+      Shader *shader = pDevice->bound_shaders[type];
+      if (!shader || !shader->cb_views.count)
+         continue;
+      for (unsigned i = 0; i < shader->cb_views.count; i++) {
+         struct pipe_resource *buffer = pDevice->cbs[type][shader->cb_views.slot[i]];
+         const unsigned view = shader->cb_views.view[i];
+         struct pipe_sampler_view *sv = pDevice->cb_sviews[type][i];
+
+         if (!sv || sv->texture != buffer) {
+            pipe_sampler_view_reference(&pDevice->cb_sviews[type][i], NULL);
+            sv = NULL;
+            if (buffer) {
+               struct pipe_sampler_view templ;
+               memset(&templ, 0, sizeof templ);
+               templ.target = PIPE_BUFFER;
+               templ.format = PIPE_FORMAT_R32G32B32A32_UINT;
+               templ.u.buf.offset = 0;
+               templ.u.buf.size = buffer->width0;
+               templ.swizzle_r = PIPE_SWIZZLE_X;
+               templ.swizzle_g = PIPE_SWIZZLE_Y;
+               templ.swizzle_b = PIPE_SWIZZLE_Z;
+               templ.swizzle_a = PIPE_SWIZZLE_W;
+               sv = pipe->create_sampler_view(pipe, buffer, &templ);
+               pDevice->cb_sviews[type][i] = sv;
+            }
+         } else if (pDevice->sampler_views[type][view] == sv) {
+            continue;
+         }
+         pDevice->sampler_views[type][view] = sv;
+         pipe->set_sampler_views(pipe, (enum pipe_shader_type)type, view, 1, 0, false, &sv);
+      }
+   }
+}
