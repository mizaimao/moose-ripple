+/* moose-ripple: a read from a constant buffer that is a buffer texture (Shader_cb_views): the
+ * element is fetched into a temporary before the instruction */
+static struct ureg_src
+translate_cb_view_read(struct Shader_xlate *sx, const struct Shader_operand *operand)
+{
+   const struct Shader_index *index = &operand->index[1];
+   struct ureg_dst coord = insn_temp(sx);
+   struct ureg_dst value = insn_temp(sx);
+   struct ureg_src src[2];
+
+   if (index->index_rep == D3D10_SB_OPERAND_INDEX_IMMEDIATE32)
+      ureg_MOV(sx->ureg, ureg_writemask(coord, TGSI_WRITEMASK_X), ureg_imm1u(sx->ureg, index->imm));
+   else if (index->imm)
+      ureg_UADD(sx->ureg, ureg_writemask(coord, TGSI_WRITEMASK_X), relative_value(sx, &index->rel),
+                ureg_imm1u(sx->ureg, index->imm));
+   else
+      ureg_MOV(sx->ureg, ureg_writemask(coord, TGSI_WRITEMASK_X), relative_value(sx, &index->rel));
+   ureg_MOV(sx->ureg, ureg_writemask(coord, TGSI_WRITEMASK_YZW), ureg_imm1u(sx->ureg, 0));
+
+   /* TXF with a sampler, as the driver's other buffer loads on virgl (use_old_tex_ops): its
+    * host does not know SAMPLE_I. The view's unsigned type makes the fetch exact. */
+   (void)src;
+   ureg_TXF(sx->ureg, value, TGSI_TEXTURE_BUFFER, ureg_src(coord),
+            sx->cb_sview[operand->index[0].imm]);
+   return ureg_src(value);
+}
