+/* Each render callback can return different buffers. Resize with a NOP before
+ * filling them, leaving the encoded virgl packet and its references intact. */
+static bool
+virgl_gdi_prepare_render(struct virgl_gdi_cmd_buf *cbuf, UINT length, UINT count)
+{
+   struct gdikmt_context *ctx = cbuf->ctx;
+   if (!ctx->pCommandBuffer || ctx->CommandBufferSize < sizeof(VIOGPU_COMMAND_HDR))
+      return false;
+   struct gdikmt_render resize = {0};
+   resize.ResizeCommandBuffer = length > ctx->CommandBufferSize;
+   resize.ResizeAllocationList = count && (!ctx->pAllocationList || count > ctx->AllocationListSize);
+   resize.ResizePatchLocationList = count && (!ctx->pPatchLocationList || count > ctx->PatchLocationListSize);
+   if (resize.ResizeCommandBuffer || resize.ResizeAllocationList || resize.ResizePatchLocationList) {
+      resize.CommandLength = sizeof(VIOGPU_COMMAND_HDR);
+      resize.NewCommandBufferSize = cbuf->command_capacity;
+      resize.NewAllocationListSize = count;
+      resize.NewPatchLocationListSize = count;
+      memset(ctx->pCommandBuffer, 0, resize.CommandLength);
+      if (!NT_SUCCESS(ctx->render(ctx, &resize)))
+         return false;
+   }
+   return ctx->pCommandBuffer && length <= ctx->CommandBufferSize &&
+          (!count || (ctx->pAllocationList && count <= ctx->AllocationListSize &&
+                      ctx->pPatchLocationList && count <= ctx->PatchLocationListSize));
+}
