; viogpu3d.inf: the moose-ripple display driver for Windows Vista SP2 x64 on QEMU's virtio-gpu.
; Vista's compositor uses Direct3D 9Ex. How to install and remove it: docs/windows/install.md.
; No catalog: the kernel driver carries its test signature itself, and Windows asks to confirm
; the package when it is installed.
[Version]
Signature="$Windows NT$"
Class=Display
ClassGUID={4d36e968-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=11/26/2026,0.5.0.0

[Manufacturer]
%Provider%=Ripple,NTamd64.6.0

[Ripple.NTamd64.6.0]
%Device%=DisplayInstall, PCI\VEN_1AF4&DEV_1050&SUBSYS_11001AF4&REV_01

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
viogpu3d.sys=1
viogpu_d3d10.dll=1
viogpu_d3d10.x86.dll=1
viogpu_wgl.dll=1
viogpu_wgl.x86.dll=1
libglapi.dll=1
libglapi.x86.dll=1

[DestinationDirs]
KernelFiles=12
Graphics64=11
Graphics32=10,SysWOW64

[KernelFiles]
viogpu3d.sys

[Graphics64]
viogpu_d3d10.dll
viogpu_wgl.dll
libglapi.dll

[Graphics32]
viogpu_d3d10.dll,viogpu_d3d10.x86.dll
viogpu_wgl.dll,viogpu_wgl.x86.dll
libglapi.dll,libglapi.x86.dll

[DisplayInstall]
FeatureScore=F6
CopyFiles=KernelFiles,Graphics64,Graphics32
AddReg=GraphicsSettings

[DisplayInstall.SoftwareSettings]
AddReg=GraphicsSettings

[GraphicsSettings]
HKR,,UserModeDriverName,0x00010000,viogpu_d3d10.dll
HKR,,InstalledDisplayDrivers,0x00010000,viogpu_d3d10
HKR,,UserModeDriverNameWow,0x00010000,viogpu_d3d10.dll
HKR,,InstalledDisplayDriversWow,0x00010000,viogpu_d3d10
; Mesa's OpenGL driver, which Windows' opengl32.dll loads for this adapter
HKR,,OpenGLDriverName,0x00010000,viogpu_wgl.dll
HKR,,OpenGLVersion,0x00010001,4096
HKR,,OpenGLFlags,0x00010001,3
HKR,,OpenGLDriverNameWow,0x00010000,viogpu_wgl.dll
HKR,,OpenGLVersionWow,0x00010001,4096
HKR,,OpenGLFlagsWow,0x00010001,3
HKR,,HWCursor,0x00010001,1
HKR,,FlexResolution,0x00010001,1
HKR,,UsePhysicalMemory,0x00010001,0
HKR,,VgaCompatible,0x00010001,0

[DisplayInstall.HW]
AddReg=InterruptSettings

[InterruptSettings]
HKR,"Interrupt Management\MessageSignaledInterruptProperties",MSISupported,0x00010001,0

[DisplayInstall.Services]
AddService=viogpu3d,0x00000002,DriverService

[DriverService]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=0
LoadOrderGroup=Video
ServiceBinary=%12%\viogpu3d.sys

[Strings]
Provider="moose-ripple"
Device="moose-ripple virtio-gpu 3D"
Disk="moose-ripple display driver for Windows Vista"
