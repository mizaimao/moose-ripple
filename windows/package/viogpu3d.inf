;
; viogpu3d.inf: the moose-ripple display driver for Windows 7 x64 on QEMU's virtio-gpu (kernel
; driver windows/kmd, user-mode driver windows/mesa). How to install and remove it:
; docs/windows/install.md.
; Made from virtio-win's viogpu3d.inx (windows/kmd/viogpu3d/viogpu3d.inx, BSD-3-Clause, see
; windows/kmd/LICENSE) for Windows 7: x64 decoration, user-mode drivers in System32 (Windows 7
; has no DriverStore directory id 13), no msdv.inf, no PnpLockdown, FeatureScore F8 (WDDM 1.0/1.1).
; No catalog: the kernel driver carries its test signature itself, and Windows asks to confirm
; the package when it is installed.
; One user-mode driver DLL with both the Direct3D 9 and the Direct3D 10 part, in a 64-bit and a
; 32-bit build, and Mesa's OpenGL driver (viogpu_wgl.dll with libglapi.dll), also in both.
;

[Version]
Signature="$Windows NT$"
Class=Display
ClassGUID={4d36e968-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=11/25/2026,0.4.0.0

[DestinationDirs]
VioGpu3D_Files.Driver   = 12   ; System32\drivers
VioGpu3D_Files.Usermode = 11   ; System32
VioGpu3D_Files.Usermode32 = 10,SysWOW64   ; the same for 32-bit programs

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
viogpu3d.sys = 1,,
viogpu_d3d10.dll = 1,,
viogpu_d3d10.x86.dll = 1,,
viogpu_wgl.dll = 1,,
viogpu_wgl.x86.dll = 1,,
libglapi.dll = 1,,
libglapi.x86.dll = 1,,

[Manufacturer]
%Provider%=Ripple,NTamd64

[Ripple.NTamd64]
%VioGpu3D.DeviceDesc% = VioGpu3D_Inst, PCI\VEN_1AF4&DEV_1050&SUBSYS_11001AF4&REV_01

[VioGpu3D_Files.Driver]
viogpu3d.sys

[VioGpu3D_Files.Usermode]
viogpu_d3d10.dll
viogpu_wgl.dll
libglapi.dll

; The 32-bit build, under the same name in SysWOW64 (destination name, source name)
[VioGpu3D_Files.Usermode32]
viogpu_d3d10.dll,viogpu_d3d10.x86.dll
viogpu_wgl.dll,viogpu_wgl.x86.dll
libglapi.dll,libglapi.x86.dll

[VioGpu3D_Inst]
; The display class installer refuses a display INF without FeatureScore ("does not support this
; version of Windows", 0xE000022D). F8: a WDDM 1.0/1.1 driver.
FeatureScore=F8
CopyFiles=VioGpu3D_Files.Driver, VioGpu3D_Files.Usermode, VioGpu3D_Files.Usermode32
AddReg=VioGpu3D_DeviceSettings

[VioGpu3D_Inst.SoftwareSettings]
AddReg = VioGpu3D_SoftwareDeviceSettings

[VioGpu3D_Inst.Services]
AddService = VioGpu3D,0x00000002,VioGpu3D_Service_Inst,VioGpu3D_EventLog_Inst

[VioGpu3D_Inst.HW]
AddReg = VioGpu3D_PCI_MSIX

; LoadOrderGroup Video, as Windows 7 display drivers have: the group before "Video Save" (VgaSave,
; the old-model fallback VGA driver). On its own it does not cure the Code 43 seen so far
; (docs/windows/kmd-port-notes.md, "Load tests", runs 3 and 4).
[VioGpu3D_Service_Inst]
ServiceType    = %SERVICE_KERNEL_DRIVER%
StartType      = %SERVICE_DEMAND_START%
ErrorControl   = %SERVICE_ERROR_IGNORE%
LoadOrderGroup = Video
ServiceBinary  = %12%\viogpu3d.sys

[VioGpu3D_EventLog_Inst]
AddReg = VioGpu3D_EventLog_Inst.AddReg

[VioGpu3D_EventLog_Inst.AddReg]
HKR,,EventMessageFile,%REG_EXPAND_SZ%,"%%SystemRoot%%\System32\IoLogMsg.dll"
HKR,,TypesSupported,%REG_DWORD%,7

[VioGpu3D_DeviceSettings]
; The pointer drawn by the host over the picture (colour pointers; others Windows draws itself)
HKR,, HWCursor,           %REG_DWORD%, 1
HKR,, FlexResolution,     %REG_DWORD%, 1
HKR,, UsePhysicalMemory,  %REG_DWORD%, 0
; Windows 7's graphics kernel reads these from this key (the driver key, Class\{4d36e968-...}\000N)
; and refuses the adapter without UserModeDriverName. User-mode drivers: first the Direct3D 9
; one, then Direct3D 10 (x64 without 32-bit ones). Both are in the same DLL.
HKR,, UserModeDriverName,     %REG_MULTI_SZ%, viogpu_d3d10.dll, viogpu_d3d10.dll
HKR,, InstalledDisplayDrivers, %REG_MULTI_SZ%, viogpu_d3d10, viogpu_d3d10
; The same for 32-bit programs, which most programs and games for Windows 7 are (DirectX's own
; diagnostics too): without these they get no Direct3D or DirectDraw acceleration at all.
HKR,, UserModeDriverNameWow,  %REG_MULTI_SZ%, viogpu_d3d10.dll, viogpu_d3d10.dll
HKR,, InstalledDisplayDriversWow, %REG_MULTI_SZ%, viogpu_d3d10, viogpu_d3d10
; The OpenGL driver Windows' opengl32.dll loads for this adapter (Mesa, with its libglapi.dll),
; for 64-bit and for 32-bit programs. Version and flags as virtio-win's INF has them.
HKR,, OpenGLDriverName,       %REG_MULTI_SZ%, viogpu_wgl.dll
HKR,, OpenGLVersion,          %REG_DWORD%, 4096
HKR,, OpenGLFlags,            %REG_DWORD%, 3
HKR,, OpenGLDriverNameWow,    %REG_MULTI_SZ%, viogpu_wgl.dll
HKR,, OpenGLVersionWow,       %REG_DWORD%, 4096
HKR,, OpenGLFlagsWow,         %REG_DWORD%, 3
HKR,, VgaCompatible,          %REG_DWORD%, 0
; No machine-wide scheduler or timeout settings: the driver reports preemption itself
; (VioGpuCommander::Preempt), and Windows' timeout detection stays as it is.
; Sleep and hibernation switched off for the whole machine, for now: the driver does not
; bring the picture back after them yet (the host forgets every surface when the guest wakes).
HKLM,"SOFTWARE\Policies\Microsoft\Power\PowerSettings\abfc2519-3608-4c2a-94ea-171b0ed546ab",ACSettingIndex,%REG_DWORD%,0
HKLM,"SOFTWARE\Policies\Microsoft\Power\PowerSettings\abfc2519-3608-4c2a-94ea-171b0ed546ab",DCSettingIndex,%REG_DWORD%,0
HKLM,"SYSTEM\CurrentControlSet\Control\Power",HibernateEnabled,%REG_DWORD%,0

; The same three again for the .SoftwareSettings section, which Windows 7 writes to the driver
; key's Settings subkey (the old display model's place for them).
[VioGpu3D_SoftwareDeviceSettings]
HKR,, UserModeDriverName,     %REG_MULTI_SZ%, viogpu_d3d10.dll, viogpu_d3d10.dll
HKR,, InstalledDisplayDrivers, %REG_MULTI_SZ%, viogpu_d3d10, viogpu_d3d10
HKR,, UserModeDriverNameWow,  %REG_MULTI_SZ%, viogpu_d3d10.dll, viogpu_d3d10.dll
HKR,, InstalledDisplayDriversWow, %REG_MULTI_SZ%, viogpu_d3d10, viogpu_d3d10
HKR,, VgaCompatible,          %REG_DWORD%, 0

[VioGpu3D_PCI_MSIX]
HKR, "Interrupt Management",, 0x00000010
HKR, "Interrupt Management\MessageSignaledInterruptProperties",, 0x00000010
HKR, "Interrupt Management\MessageSignaledInterruptProperties", MSISupported, 0x00010001, 0
HKR, "Interrupt Management\MessageSignaledInterruptProperties", MessageNumberLimit, 0x00010001, 4

[Strings]
Provider = "moose-ripple"
DiskId1 = "moose-ripple display driver for Windows 7"
VioGpu3D.DeviceDesc = "moose-ripple virtio-gpu 3D"

SERVICE_KERNEL_DRIVER = 0x1
SERVICE_DEMAND_START  = 0x3
SERVICE_ERROR_IGNORE  = 0x0
REG_MULTI_SZ  = 0x00010000
REG_EXPAND_SZ = 0x00020000
REG_DWORD     = 0x00010001
