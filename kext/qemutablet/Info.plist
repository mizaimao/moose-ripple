<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  RippleQEMUTablet: codeless kext (no code of its own). Apple's IOHIDEventDriver trims 15% off
  every absolute pointing device's range by default (IOHIDFamily 1.6.6 / 315.7.16,
  IOHIDEventDriver.cpp: absoluteAxisRemovalPercentage = 15, overridable through the
  "AbsoluteAxisBoundsRemovalPercentage" property), which makes QEMU's USB tablet place the pointer
  1.176x too far from the screen centre (KI-1 in docs/known-issues.md). This personality has Apple's
  IOHIDEventDriver drive the QEMU tablet (vendor 0x0627, product 1, Generic Desktop / Mouse;
  QEMU's keyboard shares the IDs but is usage 6) with the trim set to 0. The vendor and
  product keys outscore Apple's generic personality (IOHIDFamilyPrivate.cpp MatchPropertyTable).
-->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.mooseman.ripple.QEMUTablet</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>English</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>RippleQEMUTablet</string>
	<key>CFBundlePackageType</key>
	<string>KEXT</string>
	<key>CFBundleShortVersionString</key>
	<string>0.0.1</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>0.0.1d1</string>
	<key>IOKitPersonalities</key>
	<dict>
		<key>QEMU USB Tablet</key>
		<dict>
			<key>CFBundleIdentifier</key>
			<string>com.apple.iokit.IOHIDFamily</string>
			<key>IOClass</key>
			<string>IOHIDEventDriver</string>
			<key>IOProviderClass</key>
			<string>IOHIDInterface</string>
			<key>VendorID</key>
			<integer>1575</integer>
			<key>ProductID</key>
			<integer>1</integer>
			<key>PrimaryUsagePage</key>
			<integer>1</integer>
			<key>PrimaryUsage</key>
			<integer>2</integer>
			<key>HIDDefaultBehavior</key>
			<string></string>
			<key>AbsoluteAxisBoundsRemovalPercentage</key>
			<integer>0</integer>
		</dict>
	</dict>
	<key>OSBundleLibraries</key>
	<dict>
		<key>com.apple.iokit.IOHIDFamily</key>
		<string>1.0.0b1</string>
	</dict>
</dict>
</plist>
