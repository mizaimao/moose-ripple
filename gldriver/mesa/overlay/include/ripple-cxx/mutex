/* moose-ripple: the 10.6 SDK ships libstdc++ 4.2 (no C++11 library). This header gives the
 * little of it Mesa uses; it is found only because nothing in the SDK has this name
 * (-idirafter, patches/0004). */
#ifndef RIPPLE_CXX_MUTEX
#define RIPPLE_CXX_MUTEX
#include <pthread.h>
namespace std {
class mutex {
   pthread_mutex_t m_;
public:
   mutex() { pthread_mutex_init(&m_, 0); }
   ~mutex() { pthread_mutex_destroy(&m_); }
   mutex(const mutex &) = delete;
   mutex &operator=(const mutex &) = delete;
   void lock() { pthread_mutex_lock(&m_); }
   void unlock() { pthread_mutex_unlock(&m_); }
   bool try_lock() { return pthread_mutex_trylock(&m_) == 0; }
};
template <class M> class lock_guard {
   M &m_;
public:
   explicit lock_guard(M &m) : m_(m) { m_.lock(); }
   ~lock_guard() { m_.unlock(); }
   lock_guard(const lock_guard &) = delete;
   lock_guard &operator=(const lock_guard &) = delete;
};
}
#endif
