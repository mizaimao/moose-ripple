/* moose-ripple: the 10.6 SDK ships libstdc++ 4.2 (no C++11 library). This header gives the
 * little of it Mesa uses; it is found only because nothing in the SDK has this name
 * (-idirafter, patches/0004). */
#ifndef RIPPLE_CXX_CSTDINT
#define RIPPLE_CXX_CSTDINT
#include <stdint.h>
namespace std {
using ::int8_t; using ::int16_t; using ::int32_t; using ::int64_t;
using ::uint8_t; using ::uint16_t; using ::uint32_t; using ::uint64_t;
using ::intptr_t; using ::uintptr_t; using ::intmax_t; using ::uintmax_t;
}
#endif
