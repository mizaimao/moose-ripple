/* moose-ripple: the 10.6 SDK ships libstdc++ 4.2 (no C++11 library). This header gives the
 * little of it Mesa uses; it is found only because nothing in the SDK has this name
 * (-idirafter, patches/0004). */
#ifndef RIPPLE_CXX_TYPE_TRAITS
#define RIPPLE_CXX_TYPE_TRAITS
namespace std {
template <class T, T v> struct integral_constant {
   static constexpr T value = v;
   typedef T value_type;
   typedef integral_constant type;
   constexpr operator value_type() const { return v; }
};
typedef integral_constant<bool, true> true_type;
typedef integral_constant<bool, false> false_type;
template <class T> struct underlying_type { typedef __underlying_type(T) type; };
template <class T> using underlying_type_t = typename underlying_type<T>::type;
template <bool B, class T = void> struct enable_if {};
template <class T> struct enable_if<true, T> { typedef T type; };
template <bool B, class T = void> using enable_if_t = typename enable_if<B, T>::type;
template <class T, class U> struct is_same : integral_constant<bool, __is_same(T, U)> {};
template <class T> struct is_enum : integral_constant<bool, __is_enum(T)> {};
template <bool B, class T, class F> struct conditional { typedef T type; };
template <class T, class F> struct conditional<false, T, F> { typedef F type; };
template <bool B, class T, class F> using conditional_t = typename conditional<B, T, F>::type;
}
#endif
