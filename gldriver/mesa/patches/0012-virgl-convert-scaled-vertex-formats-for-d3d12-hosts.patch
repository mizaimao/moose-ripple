+   /* moose-ripple: reading a buffer the host has not written (still clean) needs nothing
+    * from the host. The guest's copy is the newest one, and commands not yet sent only read
+    * it. Without this, each draw whose vertex or index buffer Mesa has to read (u_vbuf
+    * converting a vertex format, or looking for the highest index) would submit the command
+    * buffer and wait for it. */
+   if (res->b.target == PIPE_BUFFER && !readback &&
