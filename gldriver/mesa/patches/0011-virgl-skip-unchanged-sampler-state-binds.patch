@@ -1229,10 +1229,20 @@
 {
    struct virgl_context *vctx = virgl_context(ctx);
    uint32_t handles[PIPE_MAX_SAMPLERS];
+   bool same = start_slot + num_samplers <= PIPE_MAX_SAMPLERS;
    int i;
    for (i = 0; i < num_samplers; i++) {
       handles[i] = (unsigned long)(samplers[i]);
+      if (same && vctx->bound_samplers[shader][start_slot + i] != handles[i])
+         same = false;
    }
+   /* moose-ripple: the state tracker binds the sampler states again whenever a texture
+    * changes, mostly the same ones (Real Racing 2: four of five binds), and the host goes
+    * through its samplers again for each. What is bound already is not sent again. */
+   if (same)
+      return;
+   if (start_slot + num_samplers <= PIPE_MAX_SAMPLERS)
+      memcpy(&vctx->bound_samplers[shader][start_slot], handles, num_samplers * sizeof(handles[0]));
    virgl_encode_bind_sampler_states(vctx, shader, start_slot, num_samplers, handles);
 }
 
