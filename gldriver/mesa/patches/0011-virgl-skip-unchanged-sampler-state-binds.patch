+/* moose-ripple: virgl_bind_sampler_states skips sampler states that are bound already. This
+ * forgets what is bound, so the next bind goes out. It has to after new sampler views: the host
+ * binds a new view on whatever unit is active and puts every unit right again only when a
+ * sampler bind marks the slots (Cinebench R11.5 drew glass with another unit's texture). Mask in
+ * RIPPLE_GL_SAMPLER_FORGET: 1 shader bind, 2 views, 4 framebuffer, 8 blit, 16 clear, 32 flush. */
+static int ripple_forget_mask = -1;
+
+static void ripple_forget_samplers(struct virgl_context *vctx, int event)
+{
+   if (ripple_forget_mask < 0) {
+      const char *env = getenv("RIPPLE_GL_SAMPLER_FORGET");
+      ripple_forget_mask = env ? atoi(env) : 3;
+   }
+   if (ripple_forget_mask & event)
+      memset(vctx->bound_samplers, 0xff, sizeof(vctx->bound_samplers));
+}
+
 static void virgl_set_framebuffer_state(struct pipe_context *ctx,
                                                 const struct pipe_framebuffer_state *state)
 {
    struct virgl_context *vctx = virgl_context(ctx);
+   ripple_forget_samplers(vctx, 4);
 
    vctx->framebuffer = *state;
    virgl_encoder_set_framebuffer_state(vctx, state);
