@@ -82,6 +82,13 @@
       else if (fb->Visual.doubleBufferMode) {
          mask |= BUFFER_BIT_BACK_LEFT;
       }
+      /* moose-ripple: the auxiliary buffers (GL_AUX0..3) of a window-system framebuffer
+       * are renderbuffers the CGL frontend attaches in color attachment slots 0..3, which
+       * such a framebuffer otherwise never uses. Apple's GL offers them, and programs of
+       * the time ask for them (issue 303). */
+      for (unsigned i = 0; i < 4; i++)
+         if (fb->Attachment[BUFFER_COLOR0 + i].Renderbuffer)
+            mask |= BUFFER_BIT_COLOR0 << i;
    }
 
    return mask;
