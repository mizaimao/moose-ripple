+/* moose-ripple: see "Buffers filled from another thread" in virgl_resource_transfer_map.
+ * Called on the context's thread. The transfer command reads the range from the buffer's
+ * guest memory when the host gets to it, which is before the command that follows. */
+void
+ripple_virgl_send_written(struct virgl_context *vctx, struct pipe_resource *res)
+{
+   struct virgl_resource *vres = virgl_resource(res);
+   uint32_t written = vres ? (uint32_t)p_atomic_read(&vres->ts_written) : 0;
+
+   if (likely(!vres || written <= vres->ts_sent))
+      return;
+
+   struct virgl_transfer t;
+   memset(&t, 0, sizeof(t));
+   t.base.resource = res;
+   t.base.usage = PIPE_MAP_WRITE;
+   u_box_1d(vres->ts_sent, written - vres->ts_sent, &t.base.box);
+   t.offset = vres->ts_sent;
+   t.hw_res = vres->hw_res;
+   if (vctx->cbuf->cdw + VIRGL_TRANSFER3D_SIZE + 1 > VIRGL_MAX_CMDBUF_DWORDS)
+      vctx->base.flush(&vctx->base, NULL, 0);
+   virgl_encode_transfer(virgl_screen(vctx->base.screen), vctx->cbuf, &t, VIRGL_TRANSFER_TO_HOST);
+   vres->ts_sent = written;
+}
