 /**
+ * moose-ripple: which samplers of an ARB or fixed-function fragment program clamp to their
+ * border (bit per sampler unit: [0] in s, [1] in t) and filter linearly ([2]), for hosts
+ * without sampler border colours. Only 2D and rectangle textures.
+ */
+void
+st_get_tex_border(struct st_context *st, struct gl_program *prog, uint32_t *border)
+{
+   struct gl_context *ctx = st->ctx;
+
+   border[0] = border[1] = border[2] = 0;
+   if (!st->emulate_tex_border || !prog || prog->shader_program)
+      return;
+
+   GLbitfield samplers_used = prog->SamplersUsed;
+   for (unsigned unit = 0; samplers_used; unit++, samplers_used >>= 1) {
+      if (!(samplers_used & 1))
+         continue;
+
+      unsigned tex_unit = prog->SamplerUnits[unit];
+      const struct gl_texture_object *texobj = ctx->Texture.Unit[tex_unit]._Current;
+      if (!texobj ||
+          (texobj->Target != GL_TEXTURE_2D && texobj->Target != GL_TEXTURE_RECTANGLE))
+         continue;
+
+      const struct gl_sampler_object *msamp = _mesa_get_samplerobj(ctx, tex_unit);
+      if (msamp->Attrib.WrapS == GL_CLAMP_TO_BORDER)
+         border[0] |= BITFIELD_BIT(unit);
+      if (msamp->Attrib.WrapT == GL_CLAMP_TO_BORDER)
+         border[1] |= BITFIELD_BIT(unit);
+      if (((border[0] | border[1]) & BITFIELD_BIT(unit)) &&
+          msamp->Attrib.MagFilter == GL_LINEAR)
+         border[2] |= BITFIELD_BIT(unit);
+   }
+}
