+/**
+ * moose-ripple: the border colour for lookups outside a texture, done here for hosts whose
+ * samplers cannot (st_context::emulate_tex_border). The host clamps such a lookup to the
+ * texture's edge; this mixes the result with the sampler's border colour by how much of the
+ * lookup falls outside: all or nothing with nearest filtering, and with linear filtering the
+ * same half-texel ramp the filter itself gives at a border. border_s, border_t and linear are
+ * bitmasks of sampler units; the colours come in as state variables.
+ */
+struct lower_tex_border_state {
+   uint32_t border_s, border_t, linear;
+   nir_variable *color[32];
+};
+
+static bool
+lower_tex_border_instr(nir_builder *b, nir_instr *instr, void *data)
+{
+   struct lower_tex_border_state *s = data;
+
+   if (instr->type != nir_instr_type_tex)
+      return false;
+
+   nir_tex_instr *tex = nir_instr_as_tex(instr);
+   if ((tex->op != nir_texop_tex && tex->op != nir_texop_txb &&
+        tex->op != nir_texop_txl && tex->op != nir_texop_txd) ||
+       (tex->sampler_dim != GLSL_SAMPLER_DIM_2D &&
+        tex->sampler_dim != GLSL_SAMPLER_DIM_RECT) ||
+       tex->is_array || tex->is_shadow)
+      return false;
+
+   unsigned unit = tex->sampler_index;
+   int deref = nir_tex_instr_src_index(tex, nir_tex_src_sampler_deref);
+   if (deref < 0)
+      deref = nir_tex_instr_src_index(tex, nir_tex_src_texture_deref);
+   if (deref >= 0) {
+      nir_variable *var =
+         nir_deref_instr_get_variable(nir_src_as_deref(tex->src[deref].src));
+      if (!var)
+         return false;
+      unit = var->data.binding;
+   }
+   if (unit >= 32 || !((s->border_s | s->border_t) & BITFIELD_BIT(unit)))
+      return false;
+
+   int coord_idx = nir_tex_instr_src_index(tex, nir_tex_src_coord);
+   if (coord_idx < 0)
+      return false;
+
+   /* in texels (this moves the cursor to before the lookup) */
+   nir_def *size = nir_i2f32(b, nir_get_texture_size(b, tex));
+
+   b->cursor = nir_after_instr(instr);
+   nir_def *coord = tex->src[coord_idx].src.ssa;
+   int proj_idx = nir_tex_instr_src_index(tex, nir_tex_src_projector);
+   nir_def *proj = proj_idx >= 0 ? tex->src[proj_idx].src.ssa : NULL;
+
+   nir_def *inside = nir_imm_float(b, 1.0);
+   for (unsigned axis = 0; axis < 2; axis++) {
+      if (!((axis ? s->border_t : s->border_s) & BITFIELD_BIT(unit)))
+         continue;
+
+      nir_def *extent = nir_channel(b, size, axis);
+      nir_def *t = nir_channel(b, coord, axis);
+      if (proj)
+         t = nir_fdiv(b, t, proj);
+      if (tex->sampler_dim != GLSL_SAMPLER_DIM_RECT)
+         t = nir_fmul(b, t, extent);
+
+      nir_def *w;
+      if (s->linear & BITFIELD_BIT(unit)) {
+         w = nir_fmul(b, nir_fsat(b, nir_fadd_imm(b, t, 0.5)),
+                      nir_fsat(b, nir_fadd_imm(b, nir_fsub(b, extent, t), 0.5)));
+      } else {
+         w = nir_b2f32(b, nir_iand(b, nir_fge(b, t, nir_imm_float(b, 0.0)),
+                                   nir_flt(b, t, extent)));
+      }
+      inside = nir_fmul(b, inside, w);
+   }
+
+   nir_def *border = nir_load_var(b, s->color[unit]);
+   nir_def *result = nir_flrp(b, border, &tex->def, inside);
+   nir_def_rewrite_uses_after(&tex->def, result, result->parent_instr);
+   return true;
+}
+
+static bool
+lower_tex_border(nir_shader *shader, struct lower_tex_border_state *state)
+{
+   return nir_shader_instructions_pass(shader, lower_tex_border_instr,
+                                       nir_metadata_control_flow, state);
+}
