[Version]
Signature="$Windows NT$"
Class=Display
ClassGuid={4D36E968-E325-11CE-BFC1-08002BE10318}
Provider=%Vendor%
DriverVer=11/20/2026,0.1.0.0

[Manufacturer]
%Vendor%=Models

[Models]
%Adapter%=Ripple,PCI\VEN_1AF4&DEV_1050

[Ripple]
CopyFiles=Miniport,Display,OpenGL
AddReg=OpenGLDriver

[Ripple.SoftwareSettings]
AddReg=DisplaySettings

[DisplaySettings]
HKR,,InstalledDisplayDrivers,0x00010000,rb2kdisp
HKR,,VgaCompatible,0x00010001,0
; Defaults for a new device. Preserve an existing desktop selection on upgrade.
HKR,,DefaultSettings.XResolution,0x00010003,1024
HKR,,DefaultSettings.YResolution,0x00010003,768
HKR,,DefaultSettings.BitsPerPel,0x00010003,32
HKR,,DefaultSettings.VRefresh,0x00010003,60

[Ripple.Services]
AddService=rb2kmp,0x00000002,VideoService

[VideoService]
ServiceType=1
StartType=1
ErrorControl=1
LoadOrderGroup=Video
ServiceBinary=%12%\rb2kmp.sys

[DestinationDirs]
Miniport=12
Display=11
OpenGL=11

[Miniport]
rb2kmp.sys

[Display]
rb2kdisp.dll

[OpenGL]
ripplegl.dll

; Windows 2000's opengl32.dll reads this key form (Dll, Version, Flags); with
; only a string value of the same name it falls back to its software OpenGL.
[OpenGLDriver]
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\OpenGLDrivers\RIPPLEGL",Dll,0x00000000,ripplegl.dll
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\OpenGLDrivers\RIPPLEGL",DriverVersion,0x00010001,1
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\OpenGLDrivers\RIPPLEGL",Flags,0x00010001,1
HKLM,"SOFTWARE\Microsoft\Windows NT\CurrentVersion\OpenGLDrivers\RIPPLEGL",Version,0x00010001,2

[SourceDisksNames]
1=%Media%

[SourceDisksFiles]
rb2kmp.sys=1
rb2kdisp.dll=1
ripplegl.dll=1

[Strings]
Vendor="moose-ripple"
Adapter="moose-ripple virtio-vga"
Media="moose-ripple Windows 2000 display driver"
