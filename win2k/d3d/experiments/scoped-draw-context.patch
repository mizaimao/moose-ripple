+void *CDECL rb_up_context_begin(struct wined3d_device *device)
+{
+    struct wined3d_surface *target;
+    if (!device->fb.render_targets[0]
+            || !(target = wined3d_rendertarget_view_get_surface(device->fb.render_targets[0])))
+        return NULL;
+    return context_acquire(device, target);
+}
+
+void CDECL rb_up_context_end(struct wined3d_context *context)
+{
+    context_release(context);
+}
