+extern void *CDECL rb_up_context_begin(struct wined3d_device *device);
+extern void CDECL rb_up_context_end(void *context);
+static int rb_group = -1;
+static unsigned int rb_draws, rb_wrapped, rb_presents;
+
+static void rb_context_report(void)
+{
+    HANDLE f;
+    DWORD count;
+    char line[128];
+    if (++rb_presents != 900) return;
+    f = CreateFileA("rbctx.log", GENERIC_WRITE, FILE_SHARE_READ, NULL, CREATE_ALWAYS,
+            FILE_ATTRIBUTE_NORMAL, NULL);
+    if (f == INVALID_HANDLE_VALUE) return;
+    wsprintfA(line, "CTX mode=%d draws=%u wrapped=%u\r\n", rb_group, rb_draws, rb_wrapped);
+    WriteFile(f, line, lstrlenA(line), &count, NULL);
+    CloseHandle(f);
+}

