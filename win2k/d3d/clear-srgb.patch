+static float clear_srgb_component(float linear)
+{
+    if (linear <= wined3d_srgb_const1[0])
+        return linear * wined3d_srgb_const0[3];
+    return wined3d_srgb_const0[1] * powf(linear, wined3d_srgb_const0[0]) - wined3d_srgb_const0[2];
+}
