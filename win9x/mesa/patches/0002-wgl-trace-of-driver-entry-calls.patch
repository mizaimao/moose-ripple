+/* moose-ripple: a trace of the calls Windows' opengl32.dll makes into the driver, in the file
+ * the environment variable RIPPLE_GL_TRACE names. One line per call, the first 20000. */
+void
+stw_trace(const char *fmt, ...)
+{
+   static FILE *f;
+   static int tried, lines;
+   va_list ap;
+
+   if (!tried) {
+      const char *name = getenv("RIPPLE_GL_TRACE");
+      tried = 1;
+      if (name && name[0])
+         f = fopen(name, "w");
+   }
+   if (!f || lines++ > 20000)
+      return;
+   va_start(ap, fmt);
+   vfprintf(f, fmt, ap);
+   va_end(ap);
+   fputc('\n', f);
+   fflush(f);
+}
