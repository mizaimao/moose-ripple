@@ -972,6 +972,25 @@
 };
 
 
+/* moose-ripple: make a context current in the calling thread with no drawable (its drawing
+ * goes to framebuffer objects), or none with 0. It looks at no window or device context, so
+ * a Direct3D driver can call it on Windows 9x while DirectDraw holds the system's 16-bit
+ * lock: wglMakeCurrent goes through GDI and KERNEL32 locks there, and a game's thread hung
+ * in it. */
+BOOL APIENTRY
+RippleMakeCurrent(DHGLRC dhglrc)
+{
+   struct stw_context *ctx = NULL;
+
+   if (dhglrc) {
+      ctx = stw_lookup_context(dhglrc);
+      if (!ctx)
+         return false;
+   }
+   return stw_make_current(NULL, NULL, ctx);
+}
+
+
 PGLCLTPROCTABLE APIENTRY
 DrvSetContext(HDC hdc, DHGLRC dhglrc, PFN_SETPROCTABLE pfnSetProcTable)
 {
