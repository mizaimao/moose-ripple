 }
 
 static void virgl_submit_cmd(struct virgl_winsys *vws,
@@ -1066,6 +1067,21 @@
    }
 }
 
+/* moose-ripple: a buffer the unsent commands name keeps its memory in the guest until they are
+ * sent, also when Mesa itself has let go of it: the chunks vertices from user memory were
+ * uploaded through, the staging buffers of texture uploads. A frame that uploads much holds all
+ * of it at once (3DMark03's second CPU test: 130 MB), and with our winsys that memory is locked.
+ * The winsys says when what only waits has grown past its limit; the commands go then, as they
+ * would when their buffer is full. Asked after a draw and after an upload through a staging
+ * buffer. */
+void virgl_flush_if_heavy(struct virgl_context *ctx)
+{
+   struct virgl_winsys *vws = virgl_screen(ctx->base.screen)->vws;
+
+   if (vws->cmd_buf_is_heavy && vws->cmd_buf_is_heavy(vws, ctx->cbuf))
+      virgl_flush_eq(ctx, ctx, NULL);
+}
+
 void virgl_flush_eq(struct virgl_context *ctx, void *closure,
                     struct pipe_fence_handle **fence)
 {
