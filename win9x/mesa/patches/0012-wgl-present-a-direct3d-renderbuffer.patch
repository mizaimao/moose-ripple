+
 #include <windows.h>
@@ -66,3 +73,4 @@
 #ifdef GALLIUM_VIRGL
+#include "stw_context.h"
 #include "virgl/rvd/rvd_virgl_public.h"
 static bool use_virgl = false;
@@ -81,1 +89,26 @@
+/* The Direct3D HAL binds a named FBO with one ordinary colour renderbuffer. Keep the
+ * render and present in order, including vertices still held by the GL frontend. */
+BOOL APIENTRY
+RipplePresentColor(void)
+{
+#ifdef GALLIUM_VIRGL
+   struct stw_context *ctx = stw_current_context();
+   if (!ctx || !use_virgl || ctx->current_framebuffer)
+      return false;
+   struct gl_context *gl = ctx->st->ctx;
+   _mesa_glthread_finish(gl);
+   struct gl_framebuffer *fb = gl->DrawBuffer;
+   if (!fb || !fb->Name || fb->_Status != GL_FRAMEBUFFER_COMPLETE)
+      return false;
+   struct gl_renderbuffer *rb = fb->Attachment[BUFFER_COLOR0].Renderbuffer;
+   if (!rb || !rb->texture || rb->TexImage)
+      return false;
+   FLUSH_VERTICES(gl, 0, 0);
+   st_flush_bitmap_cache(ctx->st);
+   return rvd_virgl_present_color(ctx->st->pipe, rb->texture, &ctx->ripple_scanout);
+#else
+   return false;
+#endif
+}
+
 static const char *created_driver_name = NULL;
