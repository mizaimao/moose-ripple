; moose-ripple display driver for Windows 95/98/ME: setup information.
; Install: Display Properties > Settings > Advanced > Adapter > Change > Have Disk,
; or point the Add New Hardware wizard at this folder.

[Version]
Signature="$CHICAGO$"
Class=Display
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=11/15/2026,0.0.1.0

[DestinationDirs]
DefaultDestDir=11                       ; WINDOWS\SYSTEM
Ripple.Copy=11

[SourceDisksNames]
1=%DiskName%,,0

[SourceDisksFiles]
ripple9x.drv=1
ripplevd.vxd=1
ripplegl.dll=1
rippledd.dll=1

[Manufacturer]
%Provider%=Ripple.Mfg

[Ripple.Mfg]
%VirtioVga.Desc%=Ripple.Install,PCI\VEN_1AF4&DEV_1050
%StdVga.Desc%=Ripple.Install,PCI\VEN_1234&DEV_1111

[Ripple.Install]
CopyFiles=Ripple.Copy
DelReg=Ripple.DelReg
AddReg=Ripple.AddReg

[Ripple.Copy]
ripple9x.drv
ripplevd.vxd
ripplegl.dll
rippledd.dll

[Ripple.DelReg]
HKR,,Ver
HKR,,DevLoader
HKR,DEFAULT
HKR,MODES
HKR,CURRENT

; minivdd: our small VxD that keeps DOS sessions and the video BIOS off the card's mode-setting
; ports while Windows has the screen.
[Ripple.AddReg]
; OpenGL: the name the display driver gives Windows' opengl32.dll, and the DLL behind it.
HKLM,Software\Microsoft\Windows\CurrentVersion\OpenGLDrivers,RIPPLEGL,,ripplegl.dll
HKR,,Ver,,4.0
HKR,,DevLoader,,*vdd
HKR,DEFAULT,Mode,,"8,640,480"
HKR,DEFAULT,drv,,ripple9x.drv
HKR,DEFAULT,vdd,,"*vdd"
HKR,DEFAULT,minivdd,,ripplevd.vxd
; RefreshRate -1: the VDD passes the monitor's limits on (without the value Windows offers
; 640x480 only). DDC 1: the VDD asks the video BIOS for the monitor's EDID at start.
HKR,DEFAULT,RefreshRate,,-1
HKR,DEFAULT,DDC,,1
HKR,"MODES\8\640,480"
HKR,"MODES\8\800,600"
HKR,"MODES\8\1024,768"
HKR,"MODES\8\1152,864"
HKR,"MODES\8\1280,720"
